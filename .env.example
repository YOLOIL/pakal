# =============================================================================
#  PAKAL - environment template
#  Copy to .env (git-ignored) and fill in real values:   cp .env.example .env
#  Every value below is a placeholder. Never commit the real .env.
#  Keycloak / LDAP / Nexus / Docker values only SEED the admin console - values
#  saved in the console (SQLite settings table) take precedence.
# =============================================================================

# --- Deployment --------------------------------------------------------------
# Registry host[:port] the portal image is pulled from, and the image tag.
PAKAL_REGISTRY=registry.example.com:5000
PAKAL_VERSION=1.8
# Public host name routed by Traefik (Host rule) - e.g. pakal.example.com
PAKAL_HOST=pakal.example.com
PORT=8971
AUTO_RESCAN_MINUTES=30

# Group id owning /var/run/docker.sock on the host:  stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# --- Admin console & emergency login (see EMERGENCY_ADMIN_README.md) ---------
# One path segment, 6-64 chars of A-Z a-z 0-9 . _ ~ -   (/admin always returns 404)
ADMIN_SECURE_PATH=/pakal-management-console
ADMIN_APP_UPLOAD_MAX_MB=8192
ADMIN_USERNAME=pakal
# bcrypt hash - generate with:  docker exec -it pakal_appstore python -m pakal.security hash-password
# Keep the single quotes (the hash contains '$'). Empty = emergency local login disabled.
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=true

# --- Keycloak (OIDC SSO) -----------------------------------------------------
KEYCLOAK_ENABLED=true
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=pakal
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_REDIRECT_URI=https://pakal.example.com/api/auth/sso/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://pakal.example.com/api/auth/sso/post-logout
KEYCLOAK_TLS_INSECURE=false
# PEM bundle of your organisational CA (used when KEYCLOAK_TLS_INSECURE=false)
KEYCLOAK_CA_BUNDLE=

# --- LDAP / Active Directory -------------------------------------------------
LDAP_URL=ldap://dc01.example.com:389
LDAP_SEARCH_BASE=DC=example,DC=com
# Service account used for display-name lookups (optional - direct user binds work without it)
LDAP_ADMIN=CN=svc_account,OU=Service Accounts,DC=example,DC=com
LDAP_PASSWORD=change-me
LDAP_ADMIN_GROUP_DN=CN=PAKAL Admins,OU=Groups,DC=example,DC=com
USER_EMAIL_DOMAIN=example.com

# --- Nexus (Actions -> Nexus Artifacts Uploader) -----------------------------
# Repository names are comma separated; the first of each format is the default target.
NEXUS_URL=https://nexus.example.com
NEXUS_USERNAME=svc_account
NEXUS_PASSWORD=change-me
NEXUS_PYPI_REPO=pypi-hosted
NEXUS_NPM_REPO=npm-hosted
NEXUS_POWERSHELL_REPO=powershell-hosted
NEXUS_TLS_INSECURE=false

# --- Docker registry catalog & ZIP-to-image builds ---------------------------
# host:port of the Nexus Docker connector, as in "docker pull host:port/name:tag"
NEXUS_DOCKER_REGISTRY=nexus.example.com:5000
# Empty username/password reuses NEXUS_USERNAME / NEXUS_PASSWORD
NEXUS_DOCKER_USERNAME=
NEXUS_DOCKER_PASSWORD=
NEXUS_DOCKER_NAMESPACE=
DOCKER_BUILD_ENABLED=true
# The Docker socket is root-equivalent on the host - keep builds admin-only unless every user is trusted.
DOCKER_BUILD_ADMIN_ONLY=true
DOCKER_MAX_CONTEXT_MB=2048
DOCKER_BUILD_TIMEOUT_SECONDS=3600
DOCKER_MAX_CONCURRENT_BUILDS=2

# --- NetApp share (host side, optional) ----------------------------------------
# Credentials for mounting the software share on the Docker host at /mnt/netapp_apps.
# Not read by the application itself.
SMB_SERVER_ADDR=netapp.example.com
SMB_USERNAME=svc_account
SMB_PASSWORD=change-me
SMB_DOMAIN=EXAMPLE
